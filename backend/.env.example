# Base de données (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth
JWT_SECRET=changez_moi

# E-mail — LOCAL uniquement (SMTP Gmail, optionnel)
EMAIL_USER=votre@gmail.com
EMAIL_PASS=mot_de_passe_application_gmail

# E-mail — PRODUCTION gratuit (Resend, sans domaine payant)
# Compte gratuit : https://resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Mode gratuit (par défaut) — ne pas modifier
# RESEND_PAID_DOMAIN=true  # uniquement si vous avez un domaine vérifié sur Resend

# URL du frontend (liens dans les e-mails + CORS)
FRONTEND_URL=https://finspirit.vercel.app
